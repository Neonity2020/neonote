{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notion-clone-web",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Secrets (never put real values here): run `wrangler secret put <NAME>` for
  //   TURSO_AUTH_TOKEN, BETTER_AUTH_SECRET
  // Non-secret runtime vars can go in "vars", e.g.:
  // "vars": {
  //   "TURSO_DATABASE_URL": "libsql://notion-clone-web-<your-turso-org>.turso.io"
  // },
}
